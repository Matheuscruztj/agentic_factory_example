# Configuração local. Gere os três segredos abaixo com:
# python scripts/setup_local_env.py
APP_SECRET_KEY=
OPERATOR_PASSWORD_HASH=
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD

# Infraestrutura: aplicações no host; PostgreSQL e Redis no Docker.
# O setup preenche a mesma senha nas URLs automaticamente.
FACTORY_ENV=local
DATABASE_URL=postgresql+psycopg://factory:REPLACE_WITH_STRONG_LOCAL_PASSWORD@127.0.0.1:5432/factory
REGISTRY_DATABASE_URL=postgresql+psycopg://factory:REPLACE_WITH_STRONG_LOCAL_PASSWORD@127.0.0.1:5432/customer_registry
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0

# Serviços locais opcionais: habilite somente os que estiverem rodando.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_CHAT=qwen3:4b
OLLAMA_MODEL_CODING=qwen2.5-coder:7b
OLLAMA_MODEL_JUDGE=
# Limites conservadores para GPU local de 8 GB.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m

# Gateway local opcional. O profile LiteLLM não publica porta no host.
# Gere um valor aleatório iniciado por sk- antes de ativar o profile.
LITELLM_ENABLED=false
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=

OPENBOT_ENABLED=false
OPENBOT_BASE_URL=http://127.0.0.1:8002
OPENBOT_API_KEY=
# Optional relative path under the OpenBot workspace for isolated repository discovery.
OPENBOT_WORKING_DIRECTORY=
# Commit SHA paired with the selected OpenBot working directory for agent provenance.
FACTORY_REPOSITORY_SHA=
OPENBOT_HEALTH_PATH=/api/v1/health
# Rota autenticada para o preflight verificar a chave.
OPENBOT_AUTH_PROBE_PATH=/api/v1/providers

PHOENIX_ENABLED=false
PHOENIX_BASE_URL=http://127.0.0.1:6006
# Reservado para instrumentação OTLP/HTTP com Phoenix local.
# O Compose base sobe apenas PostgreSQL e Redis.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006

SONAR_ENABLED=false
SONAR_HOST_URL=http://127.0.0.1:9001
SONAR_TOKEN=

# Integrações externas: preencha somente as que for usar.
# GitHub PAT: basta habilitar e informar o token, sem owner/repositório global.
GITHUB_ENABLED=false
GITHUB_AUTH_MODE=pat
GITHUB_API_URL=https://api.github.com
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
# Poll cadence and overlap are used by scripts/github_intake_worker.py.
GITHUB_POLL_SECONDS=60
GITHUB_POLL_OVERLAP_SECONDS=300
# Webhook intake is restricted to this explicit comma-separated owner/repo allowlist.
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_PROJECTS_ENABLED=false
GITHUB_PROJECT_V2_ID=
GITHUB_WEBHOOK_SECRET=
# Alternativa ao PAT: GitHub App.
# GITHUB_AUTH_MODE=app
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=

TELEGRAM_ENABLED=false
TELEGRAM_SEND_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Link da Factory usado para encaminhar decisões sensíveis à sessão autenticada.
TELEGRAM_FACTORY_UI_URL=http://localhost:5173/?tab=approvals
# Worker allowlists; comma-separated numeric Telegram IDs, no wildcard/default.
# TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_ALLOWED_USER_IDS=

JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
