# Local-only Agentic Factory configuration. Generate secrets with:
# python scripts/setup_local_env.py
FACTORY_ENV=local
FACTORY_HOST=127.0.0.1
FACTORY_API_PORT=8001
FACTORY_WEB_PORT=5173
FACTORY_WEB_URL=http://127.0.0.1:5173
FACTORY_API_URL=http://127.0.0.1:8001
FACTORY_CORS_ORIGINS=http://127.0.0.1:5173
APP_SECRET_KEY=
OPERATOR_PASSWORD_HASH=
OPERATOR_HASH_SCHEME=scrypt
LOCAL_AUTH_ENABLED=true

POSTGRES_USER=factory
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
POSTGRES_DB=factory
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://factory:REPLACE_WITH_STRONG_LOCAL_PASSWORD@127.0.0.1:5432/factory
DATABASE_URL_CONTAINER=postgresql+psycopg://factory:REPLACE_WITH_STRONG_LOCAL_PASSWORD@postgres:5432/factory
REGISTRY_DATABASE_URL=postgresql+psycopg://factory:REPLACE_WITH_STRONG_LOCAL_PASSWORD@127.0.0.1:5432/customer_registry
REGISTRY_DATABASE_URL_CONTAINER=postgresql+psycopg://factory:REPLACE_WITH_STRONG_LOCAL_PASSWORD@postgres:5432/customer_registry
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL_CONTAINER=redis://redis:6379/0
RUNTIME_DIR=.runtime
LOG_LEVEL=INFO
LOG_JSON=true
LOG_REDACT_SECRETS=true

REGISTRY_API_URL=http://127.0.0.1:8010
REGISTRY_WEB_URL=http://127.0.0.1:5174

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTAINER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_CHAT=qwen3:4b
OLLAMA_MODEL_CODING=qwen2.5-coder:7b
OLLAMA_MODEL_JUDGE=qwen3:8b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_TOOL_CALL_LIMIT=12
LLM_RETRY_LIMIT=2
LLM_PER_TASK_TOKEN_BUDGET=18000
LLM_JUDGE_ENABLED=false

OPENBOT_ENABLED=false
OPENBOT_BASE_URL=http://127.0.0.1:8002
OPENBOT_HEALTH_PATH=/api/v1/health
OPENBOT_AUTH_PROBE_PATH=
OPENBOT_API_KEY=
OPENBOT_DEFAULT_ACTOR=analyst
OPENBOT_MAX_BOT_HOPS=4
LANGGRAPH_CHECKPOINT_BACKEND=postgres
WORKER_ENABLED=false
WORKER_MAX_CONCURRENT_TASKS=1
TASK_LEASE_SECONDS=300
TASK_HEARTBEAT_SECONDS=30
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_SECONDS=30
ALLOW_AGENT_EDIT_FACTORY_CORE=false
ALLOW_AGENT_PUBLISH_PR=false
ALLOW_AGENT_MERGE=false
ALLOW_AGENT_DEPLOY=false
HITL_REQUIRED_FOR_REQUIREMENTS=true
HITL_REQUIRED_FOR_SCOPE=true
HITL_REQUIRED_FOR_PUBLISH=true
HITL_REQUIRED_FOR_POLICY=true

GITHUB_ENABLED=false
GITHUB_AUTH_MODE=pat
GITHUB_API_URL=https://api.github.com
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_POLL_SECONDS=60
GITHUB_POLL_OVERLAP_SECONDS=300
GITHUB_PROJECTS_ENABLED=false
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MODE=polling
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_WEBHOOK_SECRET=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_CLOUD_ID=
JIRA_POLL_SECONDS=60
JIRA_WEBHOOK_SHARED_SECRET=

OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentic-factory
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CAPTURE_RAW_PROMPTS=false
PHOENIX_ENABLED=false
PHOENIX_BASE_URL=http://127.0.0.1:6006
GPU_METRICS_ENABLED=false
METRICS_SAMPLE_INTERVAL_SECONDS=5
ARTIFACT_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=30
SONAR_ENABLED=false
SONAR_HOST_URL=http://127.0.0.1:9000
SONAR_PROJECT_KEY=
SONAR_TOKEN=
SECURITY_SCAN_ENABLED=false
ZAP_ENABLED=false
LOAD_TEST_ENABLED=false
REMOTE_LLM_ENABLED=false
REMOTE_LLM_API_KEY=
HF_TOKEN=
